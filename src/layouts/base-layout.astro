---
import { BLOG_FEED } from "../blog/blog-content";
import BackCover from "../components/site-chrome/back-cover.astro";
import RunningHeader from "../components/site-chrome/running-header.astro";
import { PRELOADED_FONT_URL } from "../fonts/font-subsets";
import { jsonLd } from "../seo/json-ld";
import { siteUrlOf } from "../seo/site-url";
import { canonicalUrlOf, linkPreviewTags } from "../site-chrome/link-preview";
import { SITE_PAGE_HEAD } from "../site-chrome/page-head";
import type { PageHead } from "../site-chrome/page-head";
import { sitePageAt } from "../site-chrome/site-page";

import "../styles/tokens.css";
import "../styles/focus.css";
import "../styles/links.css";
import "../styles/code-blocks.css";
import "../styles/page-frame.css";

interface Props {
  head?: PageHead;
}

const { head = SITE_PAGE_HEAD } = Astro.props;
const page = sitePageAt(Astro.url.pathname);
const canonicalUrl = canonicalUrlOf(head, Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="preload"
      href={PRELOADED_FONT_URL}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{head.title}</title>
    <meta
      name="description"
      content={head.description}
    />
    <link
      rel="canonical"
      href={canonicalUrl}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={BLOG_FEED.title}
      href={siteUrlOf(BLOG_FEED.href)}
    />
    {linkPreviewTags(head, canonicalUrl).map((tag) => (
      <meta {...tag} />
    ))}
    {head.structuredData !== undefined && (
      <script
        type="application/ld+json"
        is:inline
        set:html={jsonLd(head.structuredData)}
      />
    )}
  </head>
  <body>
    <RunningHeader page={page} />
    <main>
      <slot />
    </main>
    <BackCover />
  </body>
</html>
