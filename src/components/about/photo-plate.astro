---
import { PHOTO_PLATE } from "../../about/about-content";
// The photo plate: Danny's photo printed in ink through the coarse halftone mask, which the
// halftone integration renders from src/assets/photos before the build.
import halftoneMask from "../../assets/halftone/danny-coarse.png";
import Panel from "../manga/panel.astro";

import "../../styles/photo-plate.css";
---

<Panel class="photo-plate">
  <div
    class="profile-photo"
    role="img"
    aria-label={PHOTO_PLATE.alt}
    style={{ "--halftone-mask": `url(${halftoneMask.src})` }}
  ></div>
</Panel>
