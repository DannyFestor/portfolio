---
// The email panel: the address as the page's big inked call to action. No form.
import { EMAIL_PANEL } from "../../contact/contact-content";
import Aside from "../lettering/aside.astro";
import EmailCallToAction from "../links/email-call-to-action.astro";
import Panel from "../manga/panel.astro";

import "../../styles/email-panel.css";
import "../../styles/label.css";
---

<Panel class="email-panel">
  <h2 class="email-panel-heading label">{EMAIL_PANEL.heading}</h2>
  <p class="email-panel-address">
    <EmailCallToAction />
  </p>
  <Aside>{EMAIL_PANEL.aside}</Aside>
</Panel>
