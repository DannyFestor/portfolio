---
// The running head of a post page, as in a printed volume: the author and the chapter on the left,
// the post's title on the right. Phones show the left half only.
import { EPISODE } from "../../blog/blog-content";

import "../../styles/label.css";
import "../../styles/episode-running-head.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="episode-running-head">
  <span class="label">{EPISODE.runningHead}</span>
  <span class="episode-running-title label">{title}</span>
</header>
