---
// A composed manga page: paper with page margins and a folio (page number) at the bottom centre.
// Put a PanelGrid inside.
import type { HTMLAttributes } from "astro/types";

import "../../styles/page-composition.css";

interface Props extends HTMLAttributes<"section"> {
  folio: number;
}

const { folio, class: className, ...attributes } = Astro.props;
---

<section
  class:list={["manga-page", className]}
  {...attributes}
>
  <slot />
  <p class="manga-folio">{folio}</p>
</section>
