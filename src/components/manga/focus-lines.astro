---
// Focus lines for the one impact panel per page. Put it inside that panel, before the lettering.
import { focusLines, focusLinesPath } from "./focus-lines.ts";
import { PANEL_VIEW_BOX } from "./panel-box.ts";

import "../../styles/focus-lines.css";

const path = focusLinesPath(focusLines());
---

<svg
  class="focus-lines"
  viewBox={PANEL_VIEW_BOX}
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path d={path}></path>
</svg>
