---
// The latest writing line: the newest post's title, linking the post, and its date.
import { getCollection } from "astro:content";

import { blogPostsNewestFirst, newestPost } from "../../blog/blog-post";
import { postDateLabel, postDateTime } from "../../blog/post-date";
import { LATEST_WRITING } from "../../home/home-content";
import PeriodTag from "../lettering/period-tag.astro";
import WhiteOut from "../lettering/white-out.astro";
import Panel from "../manga/panel.astro";

import "../../styles/label.css";
import "../../styles/latest-writing-panel.css";

const post = newestPost(blogPostsNewestFirst(await getCollection("blog")));
const { title, pubDate } = post.entry.data;
---

<Panel
  class="latest-writing-panel"
  tone="light"
>
  <WhiteOut
    as="h2"
    class="label"
  >
    {LATEST_WRITING.label}
  </WhiteOut>
  <WhiteOut
    as="p"
    class="latest-writing-title"
  >
    <a href={post.href}>{title}</a>
  </WhiteOut>
  <PeriodTag
    as="time"
    datetime={postDateTime(pubDate)}
  >
    {postDateLabel(pubDate)}
  </PeriodTag>
</Panel>
