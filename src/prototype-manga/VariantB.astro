---
// PROTOTYPE — throwaway. Variant B: one continuous vertical strip of panels, read top to bottom (#7).
import { identity, latestWriting, nav, positioning, work, worlds } from "./content";
import photo from "./danny-screentone.png";

const photoVar = `--photo: url(${photo.src})`;
const [headlineSetup, headlinePunch] = positioning.headline;
const pad = (n: number): string => String(n).padStart(2, "0");
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Yomogi&family=Zen+Old+Mincho:wght@400;700;900&display=swap"
/>

<div class="variant-b" style={photoVar}>
  <header class="masthead">
    <span class="masthead-name">{identity.name}</span>
    <nav class="masthead-nav" aria-label="Main">
      {nav.map((item) => <a href={`#${item.toLowerCase()}`}>{item}</a>)}
    </nav>
  </header>

  <!-- 01 cold open -->
  <section class="row gutter-none" aria-label="Introduction">
    <div class="margin margin-left"><span class="chapter">01</span></div>
    <div class="strip">
      <div class="panel panel-photo">
        <div class="photo" role="img" aria-label="Halftone portrait of Danny Festor holding a camera"></div>
        <p class="narration narration-top">
          {identity.place}.<br />{identity.since}.
        </p>
        <p class="narration narration-bottom">
          <strong>{identity.name}</strong> — {identity.role.toLowerCase()}.
        </p>
      </div>
    </div>
    <div class="margin margin-right">
      <p class="vertical-aside">the one with the camera, not the code</p>
    </div>
  </section>

  <!-- 02 impact: setup, tight gutter, punch -->
  <section class="row gutter-long" aria-label="Positioning">
    <div class="margin margin-left"><span class="chapter">02</span></div>
    <div class="strip">
      <h1 class="headline">
        <span class="panel panel-setup">
          <span class="setup-text">{headlineSetup}</span>
          <span class="tone-corner" aria-hidden="true"></span>
        </span>
        <span class="panel panel-punch">
          <span class="focus-lines" aria-hidden="true"></span>
          <span class="focus-clear" aria-hidden="true"></span>
          <span class="punch-text">{headlinePunch}</span>
          <span class="sfx sfx-don" aria-hidden="true">ドン</span>
        </span>
      </h1>
    </div>
    <div class="margin margin-right">
      <p class="vertical-aside">yes, both. in that order.</p>
    </div>
  </section>

  <!-- 03 subline as narration -->
  <section class="row gutter" aria-label="Approach">
    <div class="margin margin-left"></div>
    <div class="strip">
      <p class="narration narration-standalone">{positioning.subline}</p>
    </div>
    <div class="margin margin-right"></div>
  </section>

  <!-- 04 two worlds, split panel -->
  <section class="row gutter-long" id="work" aria-label="Two kinds of project">
    <div class="margin margin-left"><span class="chapter">03</span></div>
    <div class="strip split">
      {
        worlds.map((world, index) => (
          <article class:list={["panel", "panel-world", index === 1 && "panel-world-toned"]}>
            <h2 class="world-title">{world.title}</h2>
            <p class="world-body">{world.body}</p>
            <p class="aside">— {world.aside}</p>
          </article>
        ))
      }
    </div>
    <div class="margin margin-right">
      <p class="vertical-aside">two doors, one engineer</p>
    </div>
  </section>

  <!-- 05 work sequence -->
  {
    work.map((item, index) => (
      <section class:list={["row", index === 0 ? "gutter-long" : "gutter"]} aria-label={item.title}>
        <div class="margin margin-left">
          <span class="chapter">{pad(index + 4)}</span>
        </div>
        <div class="strip">
          <article class="work">
            <div class="work-top">
              <div class="panel panel-period">
                <span class="period">{item.period}</span>
              </div>
              <div class="panel panel-work">
                <h2 class="work-title">{item.title}</h2>
                <p class="work-client">{item.client}</p>
                <p class="work-beat">{item.beat}</p>
                <p class="work-stack">{item.stack.join(" · ")}</p>
              </div>
            </div>
            <div class:list={["panel", "panel-impact", index === 1 && "panel-impact-sfx"]}>
              <p class="impact">{item.impact}</p>
              {index === 1 && (
                <span class="sfx sfx-shu" aria-hidden="true">
                  {item.sfx}
                </span>
              )}
            </div>
          </article>
        </div>
        <div class="margin margin-right">
          <p class="vertical-aside">{item.stack[0]} et al.</p>
        </div>
      </section>
    ))
  }

  <!-- 06 latest writing -->
  <section class="row gutter-long" id="blog" aria-label="Latest writing">
    <div class="margin margin-left"><span class="chapter">07</span></div>
    <div class="strip">
      <a class="panel panel-writing" href="#blog">
        <span class="writing-label">Latest writing</span>
        <span class="writing-title">{latestWriting.title}</span>
        <time class="writing-date" datetime={latestWriting.date}>{latestWriting.date}</time>
      </a>
    </div>
    <div class="margin margin-right"></div>
  </section>

  <!-- 07 contact, final panel -->
  <section class="row gutter-long" id="contact" aria-label="Contact">
    <div class="margin margin-left"><span class="chapter">08</span></div>
    <div class="strip">
      <div class="panel panel-contact">
        <div class="contact-photo" aria-hidden="true"></div>
        <div class="contact-body">
          <p class="status"><span class="status-mark" aria-hidden="true"></span>{identity.status}</p>
          <a class="email" href={`mailto:${identity.email}`}>{identity.email}</a>
          <p class="contact-line">{identity.languages}</p>
          <p class="aside">{identity.responseTime}</p>
        </div>
      </div>
    </div>
    <div class="margin margin-right">
      <p class="vertical-aside">a plain email. no form.</p>
    </div>
  </section>

  <!-- 08 colophon -->
  <footer class="row gutter-long colophon">
    <div class="margin margin-left"></div>
    <div class="strip">
      <p class="end-mark">End of chapter one</p>
      <p class="confession">{identity.mangaConfession}</p>
      <nav class="colophon-nav" aria-label="Footer">
        {nav.map((item) => <a href={`#${item.toLowerCase()}`}>{item}</a>)}
      </nav>
      <p class="folio">festor.info · {identity.name}</p>
    </div>
    <div class="margin margin-right"></div>
  </footer>
</div>

<style>
  .variant-b {
    --paper: #efeadf;
    --ink: #1b1a17;
    --spot: #d24e1c;
    --font-display: "Dela Gothic One", serif;
    --font-text: "Zen Old Mincho", serif;
    --font-aside: "Yomogi", cursive;
    --rule: 3px;
    --gutter-tight: 6px;
    --gutter: 32px;
    --gutter-long: 112px;
    --strip: 620px;
    --tone: radial-gradient(circle, var(--ink) 1.05px, transparent 1.45px) 0 0 / 6px 6px,
      radial-gradient(circle, var(--ink) 1.05px, transparent 1.45px) 3px 3px / 6px 6px;
    --tone-spot: radial-gradient(circle, var(--spot) 1.3px, transparent 1.7px) 0 0 / 7px 7px,
      radial-gradient(circle, var(--spot) 1.3px, transparent 1.7px) 3.5px 3.5px / 7px 7px;

    min-height: 100vh;
    padding-bottom: 96px;
    font-family: var(--font-text);
    color: var(--ink);
    background: var(--paper);
  }

  /* masthead: a thin running head like the top of a printed page */
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: min(var(--strip), 100% - 32px);
    margin: 0 auto;
    padding: 20px 0 10px;
    border-bottom: 1px solid var(--ink);
    font-size: 14px;
  }

  .masthead-name {
    font-family: var(--font-display);
    letter-spacing: 0.02em;
  }

  .masthead-nav {
    display: flex;
    gap: 18px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .masthead-nav a,
  .colophon-nav a {
    border-bottom: 1px solid transparent;
  }

  .masthead-nav a:hover,
  .colophon-nav a:hover {
    border-bottom-color: var(--ink);
  }

  /* the strip: margin | panels | margin */
  .row {
    display: grid;
    grid-template-columns: 1fr minmax(0, var(--strip)) 1fr;
    column-gap: 28px;
  }

  .gutter-none {
    margin-top: 28px;
  }

  .gutter {
    margin-top: var(--gutter);
  }

  .gutter-long {
    margin-top: var(--gutter-long);
  }

  .margin {
    display: flex;
    padding-top: 4px;
  }

  .margin-left {
    justify-content: flex-end;
  }

  .chapter {
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0.08em;
    padding-top: 6px;
    border-top: var(--rule) solid var(--ink);
  }

  .vertical-aside {
    margin: 0;
    font-family: var(--font-aside);
    font-size: 15px;
    line-height: 1.3;
    writing-mode: vertical-rl;
    color: var(--ink);
  }

  .panel {
    position: relative;
    display: block;
    overflow: hidden;
    border: var(--rule) solid var(--ink);
    background: var(--paper);
  }

  /* 01 cold open */
  .panel-photo {
    aspect-ratio: 4 / 5;
  }

  .photo {
    position: absolute;
    inset: 0;
    background: var(--ink);
    mask: var(--photo) 18% 26% / 150% auto no-repeat;
    -webkit-mask: var(--photo) 18% 26% / 150% auto no-repeat;
  }

  .narration {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    background: var(--paper);
    border: 2px solid var(--ink);
  }

  .narration-top {
    position: absolute;
    top: 18px;
    right: 18px;
    padding: 10px 14px;
    max-width: 46%;
  }

  .narration-bottom {
    position: absolute;
    left: 18px;
    bottom: 18px;
    padding: 10px 14px;
    max-width: 70%;
  }

  /* 02 impact */
  .headline {
    display: grid;
    gap: var(--gutter-tight);
    margin: 0;
    font-weight: normal;
  }

  .panel-setup {
    padding: 40px 28px 44px;
  }

  .setup-text {
    position: relative;
    z-index: 1;
    font-family: var(--font-text);
    font-weight: 700;
    font-size: clamp(28px, 6vw, 40px);
    line-height: 1.1;
  }

  .tone-corner {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 42%;
    height: 70%;
    background: var(--tone);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  .panel-punch {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    padding: 24px;
  }

  .focus-lines {
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(from 0deg at 50% 54%, var(--ink) 0deg 0.55deg, transparent 0.55deg 3.1deg);
  }

  .focus-clear {
    position: absolute;
    left: 50%;
    top: 54%;
    width: 86%;
    height: 54%;
    border-radius: 50%;
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .punch-text {
    position: relative;
    z-index: 1;
    max-width: 9ch;
    font-family: var(--font-display);
    font-size: clamp(44px, 11vw, 76px);
    line-height: 1.02;
    text-align: center;
  }

  .sfx {
    position: absolute;
    z-index: 2;
    font-family: var(--font-display);
    color: var(--spot);
    -webkit-text-stroke: 2px var(--ink);
    paint-order: stroke fill;
    line-height: 1;
  }

  .sfx-don {
    top: 7%;
    right: 6%;
    font-size: clamp(56px, 12vw, 92px);
    transform: rotate(-12deg);
  }

  /* 03 subline */
  .narration-standalone {
    max-width: 30ch;
    padding: 16px 20px;
    font-size: 20px;
    line-height: 1.5;
  }

  /* 04 two worlds */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter-tight);
  }

  .panel-world {
    padding: 22px 20px 20px;
  }

  .panel-world:first-child {
    margin-top: 48px;
  }

  .panel-world-toned {
    padding-bottom: 92px;
  }

  .panel-world-toned::before {
    content: "";
    position: absolute;
    inset: auto -1px -1px auto;
    width: 64%;
    height: 72px;
    background: var(--tone-spot);
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
  }

  .world-title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: normal;
    font-size: 22px;
    line-height: 1.1;
  }

  .world-body {
    position: relative;
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.6;
  }

  .aside {
    position: relative;
    margin: 0;
    font-family: var(--font-aside);
    font-size: 16px;
    line-height: 1.4;
    transform: rotate(-1.5deg);
    transform-origin: left center;
  }

  /* 05 work */
  .work {
    display: grid;
    gap: var(--gutter-tight);
  }

  .work-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: var(--gutter-tight);
  }

  .panel-period {
    display: grid;
    place-items: end start;
    padding: 14px;
    background: var(--tone);
    background-color: var(--paper);
  }

  .period {
    padding: 6px 8px;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.1;
    background: var(--paper);
    border: 2px solid var(--ink);
  }

  .panel-work {
    padding: 20px 22px;
  }

  .work-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: normal;
    font-size: 24px;
    line-height: 1.15;
  }

  .work-client {
    margin: 6px 0 14px;
    font-size: 14px;
  }

  .work-beat {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.6;
  }

  .work-stack {
    margin: 0;
    padding-top: 10px;
    border-top: 1px solid var(--ink);
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .panel-impact {
    padding: 18px 22px;
  }

  .impact {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 5vw, 30px);
    line-height: 1.1;
  }

  .impact::before {
    content: "";
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 12px;
    background: var(--spot);
    vertical-align: 0.12em;
  }

  .panel-impact-sfx {
    padding: 64px 22px 22px;
  }

  .panel-impact-sfx::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(180deg, var(--ink) 0 1px, transparent 1px 7px);
    clip-path: polygon(0 10%, 100% 4%, 100% 40%, 0 34%);
  }

  .sfx-shu {
    right: 6%;
    top: 4px;
    font-size: clamp(40px, 8vw, 54px);
    transform: rotate(-6deg);
  }

  /* 06 writing */
  .panel-writing {
    display: grid;
    gap: 6px;
    width: 72%;
    margin-left: auto;
    padding: 16px 18px;
  }

  .panel-writing:hover {
    border-width: 5px;
    padding: 14px 16px;
  }

  .writing-label {
    font-family: var(--font-aside);
    font-size: 14px;
  }

  .writing-title {
    font-weight: 700;
    font-size: 17px;
    line-height: 1.35;
  }

  .writing-date {
    font-size: 13px;
  }

  /* 07 contact */
  .panel-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    min-height: 300px;
    border-width: 5px;
  }

  .contact-photo {
    border-right: var(--rule) solid var(--ink);
    background: var(--spot);
    mask: var(--photo) 32% 22% / 230% auto no-repeat;
    -webkit-mask: var(--photo) 32% 22% / 230% auto no-repeat;
  }

  .contact-body {
    display: grid;
    align-content: center;
    gap: 14px;
    padding: 28px 26px;
  }

  .status {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 0;
    font-size: 15px;
  }

  .status-mark {
    width: 12px;
    height: 12px;
    background: var(--spot);
  }

  .email {
    width: fit-content;
    font-family: var(--font-display);
    font-size: clamp(22px, 5vw, 30px);
    line-height: 1.1;
    border-bottom: var(--rule) solid var(--ink);
  }

  .email:hover {
    border-bottom-color: var(--spot);
  }

  .contact-line {
    margin: 0;
    font-size: 16px;
  }

  /* 08 colophon */
  .colophon .strip {
    display: grid;
    gap: 14px;
    justify-items: center;
    padding-top: 22px;
    border-top: 1px solid var(--ink);
    text-align: center;
  }

  .end-mark {
    margin: 0;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .confession {
    margin: 0;
    font-family: var(--font-aside);
    font-size: 17px;
  }

  .colophon-nav {
    display: flex;
    gap: 18px;
    font-size: 14px;
  }

  .folio {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  /* phone: the strip fills the width; margin lettering moves inline or disappears */
  @media (width <= 760px) {
    .variant-b {
      --gutter-long: 72px;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      padding: 0 12px;
    }

    .margin-right {
      display: none;
    }

    .margin-left {
      justify-content: flex-start;
      padding: 0 0 8px;
    }

    .margin-left:empty {
      display: none;
    }

    .masthead {
      flex-direction: column;
      gap: 8px;
    }

    .split,
    .work-top,
    .panel-contact {
      grid-template-columns: minmax(0, 1fr);
    }

    .panel-world:first-child {
      margin-top: 0;
    }

    .panel-period {
      min-height: 64px;
    }

    .contact-photo {
      aspect-ratio: 16 / 9;
      border-right: 0;
      border-bottom: var(--rule) solid var(--ink);
    }

    .panel-writing {
      width: auto;
    }
  }
</style>
