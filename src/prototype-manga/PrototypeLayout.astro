---
// PROTOTYPE — throwaway. Layout for the page prototypes (#7): shared design system, masthead,
// and the ?variant= switcher. Pages render each variant as
// <div class="variant" data-variant-panel="X">…</div> (keys A to D) inside the default slot.
import "./system.css";
import ChromeBoot from "./chrome/ChromeBoot.astro";
import { defaultChrome } from "./chrome/chrome-sets";
import ChromeSwitcher from "./chrome/ChromeSwitcher.astro";
import SiteFooter from "./chrome/SiteFooter.astro";
import SiteHeader from "./chrome/SiteHeader.astro";
import PrototypeSwitcher from "./PrototypeSwitcher.astro";

interface Props {
  title: string;
  variants: readonly { key: string; name: string }[];
  /** Path of the current page for the header and nav, e.g. "/about". */
  current?: string;
  /** Variant shown when no ?variant= is given: the chosen design for this page. */
  defaultVariant?: string;
}

const { title, variants, current = "/", defaultVariant } = Astro.props;
const keys = variants.map((variant) => variant.key);
const firstKey = defaultVariant ?? keys[0] ?? "A";
---

<!doctype html>
<html lang="en" data-variant={firstKey} data-chrome={defaultChrome}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Antique&family=Shippori+Mincho:wght@400;600;700&family=Yomogi&display=swap"
    />
    <script is:inline define:vars={{ keys }}>
      // Pick the variant before first paint so there is no flash of the default one.
      const requested = new URLSearchParams(location.search).get("variant");
      if (requested && keys.includes(requested)) document.documentElement.dataset.variant = requested;
    </script>
    <ChromeBoot />
  </head>
  <body>
    <div class="manga">
      <slot name="header"><SiteHeader current={current} /></slot>
      <slot />
      <SiteFooter current={current} />
    </div>
    <PrototypeSwitcher variants={variants} />
    <ChromeSwitcher />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
  }

  .variant {
    display: none;
  }

  html[data-variant="A"] [data-variant-panel="A"],
  html[data-variant="B"] [data-variant-panel="B"],
  html[data-variant="C"] [data-variant-panel="C"],
  html[data-variant="D"] [data-variant-panel="D"] {
    display: block;
  }
</style>
