---
// PROTOTYPE — throwaway. The heading ladder set as the top of a Work page.
import { scaleSample } from "./typography-content";
---

<div class="ty-scale">
  <h3 class="display ty-h1">{scaleSample.pageTitle}</h3>
  <h4 class="display ty-h2">{scaleSample.caseTitle}</h4>
  <h5 class="display ty-h3">{scaleSample.sectionTitle}</h5>
  <p class="ty-text">{scaleSample.body}</p>
  <h6 class="display ty-h4">{scaleSample.minorTitle}</h6>
  <p class="ty-text">{scaleSample.stack}</p>
</div>
