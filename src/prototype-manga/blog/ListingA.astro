---
// PROTOTYPE — throwaway. Blog listing variant A: magazine table of contents (目次).
// One composed page: a tall title panel with vertical 目次 lettering, and a ToC column where
// each post is a single line with a dotted leader to its date, like a printed contents page.
import { chapterNumber, formatDate, posts } from "./posts";
---

<section class="manga-page toc-page">
  <div class="manga-grid toc-grid">
    <div class="panel title-panel tone-light">
      <span class="tone-fade tone-fade--up" aria-hidden="true"></span>
      <p class="toc-kanji display fuchidori" aria-hidden="true">目次</p>
      <div class="title-text">
        <p class="small-label halo">Writing</p>
        <h1 class="display toc-heading halo">Contents</h1>
      </div>
      <p class="aside title-aside">engineering notes, no hot takes</p>
    </div>

    <div class="panel toc-panel">
      <p class="narration toc-intro">
        Technical writing from client work: what broke, what I decided, and why. New chapters when
        there is something worth writing down.
      </p>
      <ol class="toc-list">
        {
          posts.map((post, index) => (
            <li class:list={["toc-entry", { placeholder: post.placeholder }]}>
              <span class="toc-number display">{chapterNumber(index)}</span>
              <span class="toc-body">
                <a class="toc-title display" href={post.placeholder ? "#" : `/blog/${post.slug}`}>
                  {post.title}
                </a>
                <span class="toc-tags">{post.tags.join(" · ")}</span>
              </span>
              <span class="toc-leader" aria-hidden="true" />
              <time class="toc-date" datetime={post.date}>
                {formatDate(post.date)}
              </time>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
  <p class="folio">— 1 —</p>
</section>

<style>
  .toc-grid {
    grid-template-areas: "title title title toc toc toc toc toc toc toc toc toc";
    grid-template-rows: minmax(560px, auto);
  }

  .title-panel {
    display: flex;
    flex-direction: column;
    grid-area: title;
    justify-content: space-between;
    padding: 22px 18px;
  }

  .toc-kanji {
    align-self: center;
    margin-top: 12px;
    font-size: 108px;
    line-height: 1.05;
    writing-mode: vertical-rl;
  }

  .title-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .toc-heading {
    font-size: 30px;
  }

  .title-aside {
    align-self: flex-end;
    color: var(--accent);
    transform: rotate(-2deg);
  }

  .toc-panel {
    display: flex;
    flex-direction: column;
    grid-area: toc;
    gap: 20px;
    padding: 26px 30px;
  }

  .toc-intro {
    max-width: 52ch;
  }

  .toc-list {
    padding: 0;
    list-style: none;
  }

  .toc-entry {
    display: grid;
    grid-template-columns: 44px minmax(0, auto) 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--ink);
  }

  .toc-entry:first-child {
    border-top: 2px solid var(--ink);
  }

  .toc-number {
    font-size: 22px;
    color: var(--indigo);
  }

  .toc-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 46ch;
  }

  .toc-title {
    font-size: 19px;
    line-height: 1.3;
    text-decoration: none;
  }

  .toc-title:hover {
    text-decoration: underline 3px var(--accent);
  }

  .toc-tags {
    font-family: var(--hand);
    font-size: 13px;
    color: #6d6a62;
  }

  .toc-leader {
    align-self: end;
    min-width: 24px;
    height: 0.6em;
    margin-bottom: 0.3em;
    border-bottom: 2px dotted var(--ink);
  }

  .toc-date {
    align-self: end;
    font-family: var(--display);
    font-size: 13px;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .placeholder {
    opacity: 0.45;
  }

  @media (width <= 760px) {
    .title-panel {
      min-height: 170px;
      gap: 10px;
      padding-right: 84px;
    }

    .toc-kanji {
      position: absolute;
      top: 8px;
      right: 12px;
      margin: 0;
      font-size: 54px;
    }

    .toc-panel {
      padding: 18px 16px;
    }

    .toc-entry {
      grid-template-columns: 36px 1fr;
    }

    .toc-leader {
      display: none;
    }

    .toc-date {
      grid-column: 2;
    }
  }
</style>
