---
// PROTOTYPE — throwaway. Contact variant C: "Reader mail" (おたより corner).
// The reader-letters page of a manga magazine: quiet and text-led, no impact moment.
// A letter from Danny on the left; on the right, the "send your letter to" address card with the email,
// a checklist of what to include, and a postmark-style status stamp. Fine print at the bottom.
import { identity } from "../content";

const [emailLocal, emailDomain] = identity.email.split("@");
import photo from "../danny-screentone.png";
import { contactCopy, letter } from "./contact-content";
---

<section class="manga-page" aria-labelledby="contact-c-title">
  <header class="corner-head">
    <div class="stamp-photo" style={`--photo: url(${photo.src})`} role="img" aria-label={`Photo of ${identity.name}`}></div>
    <div>
      <p class="small-label">The letters corner</p>
      <h1 id="contact-c-title" class="display corner-title">Reader mail</h1>
    </div>
    <p class="corner-ja display" aria-hidden="true">おたより</p>
  </header>

  <div class="manga-grid grid">
    <div class="panel address">
      <p class="small-label">Send your letter to</p>
      <a class="display email" href={`mailto:${identity.email}`}>{emailLocal}@<wbr />{emailDomain}</a>
      <p class="aside address-aside">{contactCopy.noForm}</p>
      <p class="postmark" aria-label={identity.status}>
        <span class="postmark-ring" aria-hidden="true">Open</span>
        <span class="postmark-text">{identity.status}</span>
      </p>
    </div>

    <div class="panel include">
      <p class="small-label">Please include</p>
      <ol class="checklist">
        {letter.checklist.map((item) => <li>{item}</li>)}
      </ol>
    </div>
    <article class="panel tone-light letter-panel">
      <div class="letter">
        <p class="salutation display">{letter.salutation}</p>
        {letter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="sign-off aside">{letter.signOff}</p>
      </div>
    </article>
  </div>

  <footer class="fine-print">
    <p>{identity.responseTime}. {contactCopy.location}.</p>
    <p class="languages">{identity.languages}</p>
  </footer>
  <p class="folio">Letters · 1</p>
</section>

<style>
  .corner-head {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 20px;
    align-items: end;
    padding-bottom: 18px;
    margin-bottom: 22px;
    border-bottom: var(--line) solid var(--ink);
  }

  .stamp-photo {
    width: 96px;
    height: 120px;
    background: var(--ink);
    border: 2px solid var(--ink);
    mask: var(--photo) 34% 24% / 260% auto no-repeat;
  }

  .corner-title {
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
  }

  .corner-ja {
    font-size: 28px;
    letter-spacing: 0.1em;
    writing-mode: vertical-rl;
  }

  .grid {
    grid-template-rows: auto auto;
    grid-template-areas:
      "let let let let let let let adr adr adr adr adr"
      "let let let let let let let inc inc inc inc inc";
  }

  .letter-panel {
    grid-area: let;
    padding: 22px;
  }

  .letter {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 26px 28px;
    font-size: 17px;
    line-height: 1.75;
    background: var(--paper);
    border: 2px solid var(--ink);
  }

  .salutation {
    font-size: 22px;
  }

  .sign-off {
    align-self: flex-end;
    font-size: 20px;
  }

  .address {
    display: flex;
    flex-direction: column;
    grid-area: adr;
    gap: 14px;
    padding: 26px 24px 28px;
    border-width: 6px;
    border-style: double;
  }

  .email {
    font-size: clamp(26px, 2.9vw, 36px);
    line-height: 1.1;
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }

  .email:hover {
    text-decoration-thickness: 6px;
  }

  .address-aside {
    color: var(--accent);
  }

  .postmark {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
  }

  .postmark-ring {
    display: grid;
    flex: none;
    place-items: center;
    width: 64px;
    height: 64px;
    font-family: var(--display);
    font-size: 13px;
    letter-spacing: 0.16em;
    color: var(--accent);
    text-transform: uppercase;
    border: 2px solid var(--accent);
    border-radius: 50%;
    transform: rotate(-12deg);
  }

  .postmark-text {
    font-family: var(--display);
    font-size: 18px;
  }

  .include {
    grid-area: inc;
    padding: 20px 24px;
  }

  .checklist {
    display: grid;
    gap: 8px;
    padding-left: 22px;
    margin: 12px 0 0;
    font-size: 16px;
  }

  .checklist li::marker {
    font-family: var(--display);
    color: var(--accent);
  }

  .fine-print {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    justify-content: space-between;
    padding-top: 14px;
    margin-top: 22px;
    font-size: 14px;
    border-top: 1px solid var(--ink);
  }

  .languages {
    font-family: var(--display);
    font-size: 16px;
  }

  @media (width <= 760px) {
    .corner-head {
      grid-template-columns: 72px 1fr;
    }

    .stamp-photo {
      width: 72px;
      height: 90px;
    }

    .corner-ja {
      display: none;
    }

    .letter-panel {
      padding: 12px;
    }

    .letter {
      padding: 18px;
      font-size: 16px;
    }
  }
</style>
