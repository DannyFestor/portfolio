{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // The manga panel system (#32) is a component library for the pages (#15 to #19). Until a page
  // uses its components, they are entry points; drop that pattern once one does. Scripts run as
  // tasks (`vp run fonts:subset`), which knip does not trace to their files.
  "entry": ["src/components/manga/*.astro", "scripts/*.ts"],
  "ignoreBinaries": [
    // uv runs pyftsubset for scripts/subset-fonts.ts; it is a system tool, so the project has no Python.
    "uvx",
  ],
  "ignoreDependencies": [
    // Loaded by the `astro check` command, which knip cannot trace to the package.
    "@astrojs/check",
    // The Vite+ catalog alias that resolves Astro's vite to @voidzero-dev/vite-plus-core.
    "vite",
  ],
}
